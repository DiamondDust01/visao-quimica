# Copie para .env e preencha. Sem VITE_FIREBASE_CONFIG o app roda offline e as salas
# funcionam só como demonstração local.
VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","appId":"..."}
VITE_APP_ID=visao-quimica
# Endereço HTTPS publicado, usado no link e no QR de entrada das salas.
VITE_PUBLIC_APP_URL=
# Só em desenvolvimento: 1 liga autenticação e Firestore aos emuladores locais.
VITE_FIREBASE_EMULATORS=0
